# Копируем в .env. Сам .env в репозиторий не попадает.
# Секретов здесь нет: токен Яндекс получаем device-flow'ом, Spotify — PKCE.

# Client ID приложения Spotify (публичный, но всё же не в код)
SPOTIFY_CLIENT_ID=

# Только если redirect URI другой, чем в коде по умолчанию
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8899/callback

# Необязательно, по умолчанию берётся список из soundbridge/config.py
SPOTIFY_SCOPES=playlist-read-private,playlist-read-collaborative,playlist-modify-private,playlist-modify-public,user-library-read,user-library-modify,user-read-email,user-private

# 0 = разрешить реальную запись в Spotify (то же, что --apply в CLI)
SB_IMPORT_DRY_RUN=1

# Браузер не открывается или нужен другой клиент — утилита выдаст ссылку и
# попросит вставить адрес, на который Spotify перенаправит браузер
# SB_NO_BROWSER=1

# Корень проекта, если запуск не из папки Soundbridge
# SOUNDBRIDGE_HOME=C:\path\to\Soundbridge
